{
  "name": "fireline-examples-discovery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Discovery-only external consumer examples for Fireline managed-agent surfaces.",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run check:surface",
    "check:surface": "tsx scripts/check-surface.ts",
    "build:editable-agent-web": "vite build --config examples/02-editable-agent-web/vite.config.ts",
    "build:next-basic": "next build examples/04-next-basic",
    "build:next-open-cloudflare": "next build examples/05-next-open-cloudflare",
    "build:opennext-cloudflare": "cd examples/05-next-open-cloudflare && opennextjs-cloudflare build --skipWranglerConfigCheck --dangerouslyUseUnsupportedNextVersion",
    "build:tanstack-shaped": "vite build --config examples/03-tanstack-shaped-app/vite.config.ts",
    "dev:editable-agent-web": "vite --config examples/02-editable-agent-web/vite.config.ts",
    "dev:next-basic": "next dev examples/04-next-basic -p 5174",
    "dev:next-open-cloudflare": "next dev examples/05-next-open-cloudflare -p 5175",
    "dev:tanstack-shaped": "vite --config examples/03-tanstack-shaped-app/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "smoke:inline-js-local": "sh -c 'CONTROL_STREAM=${FIRELINE_CONTROL_STREAM:-fireline-examples-control}; STREAMS_PORT=${FIRELINE_STREAMS_PORT:-7474}; export FIRELINE_LAUNCH_CONTROL_STREAM_URL=${FIRELINE_LAUNCH_CONTROL_STREAM_URL:-http://127.0.0.1:${STREAMS_PORT}/v1/stream/${CONTROL_STREAM}}; fireline-v3-dev --state-stream \"$CONTROL_STREAM\" -- tsx examples/01-inline-js-local/run.ts'",
    "smoke:flamecast-shaped": "sh -c 'CONTROL_STREAM=${FIRELINE_CONTROL_STREAM:-fireline-flamecast-shaped-control}; STREAMS_PORT=${FIRELINE_STREAMS_PORT:-7474}; export FIRELINE_LAUNCH_CONTROL_STREAM_URL=${FIRELINE_LAUNCH_CONTROL_STREAM_URL:-http://127.0.0.1:${STREAMS_PORT}/v1/stream/${CONTROL_STREAM}}; fireline-v3-dev --state-stream \"$CONTROL_STREAM\" -- tsx examples/06-flamecast-v3-shaped/src/run.ts'"
  },
  "dependencies": {
    "@fireline/client": "file:/tmp/fireline-mono-oet.29.3.1-artifacts/fireline-client-0.0.1.tgz",
    "@fireline/runtime": "file:/tmp/fireline-mono-oet.29.3.1-artifacts/fireline-runtime-0.0.1.tgz",
    "@fireline/runtime-darwin-arm64": "file:/tmp/fireline-mono-oet.29.3.1-artifacts/fireline-runtime-darwin-arm64-0.0.1.tgz",
    "@fireline/state": "file:/tmp/fireline-mono-oet.29.3.1-artifacts/fireline-state-0.0.1.tgz"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.19.1",
    "@tanstack/react-query": "5.99.2",
    "@tanstack/react-router": "1.168.23",
    "@tanstack/react-start": "1.167.42",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "next": "16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0",
    "vite": "^8.0.8"
  }
}
