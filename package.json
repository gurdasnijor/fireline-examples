    "dev:editable-agent-web": "vite --config examples/02-editable-agent-web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "smoke:inline-js-local": "fireline-v3-dev -- tsx examples/01-inline-js-local/run.ts"
  },
  "dependencies": {
